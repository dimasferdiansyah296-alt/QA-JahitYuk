# =====================================================================
# Salin file ini menjadi .env lalu isi sesuai aplikasi yang diuji.
#   cp .env.example .env
# File .env TIDAK BOLEH di-commit (sudah ada di .gitignore).
# =====================================================================

# --- Target aplikasi -------------------------------------------------
# URL aplikasi yang diuji. Untuk JAHITYUK (Laragon) gunakan .test.
# Untuk latihan modul, jalankan `npm run demo` lalu pakai
# http://localhost:4173
BASE_URL=http://jahityuk.test

# Nama aplikasi & environment (muncul di laporan DOCX)
APP_NAME=JAHITYUK (Sistem Manajemen Penjahitan)
TEST_ENV=local
# Isi "production" HANYA jika memang diizinkan. Mode production
# membuat discovery hanya membaca halaman (read-only).

# --- Akun pengujian (per role) ---------------------------------------
# Format: <ROLE>_USER dan <ROLE>_PASS. Ganti dengan akun uji resmi
# JAHITYUK. JANGAN tulis kredensial asli di file ini.
# Role aplikasi: ADMIN, KARYAWAN, PELANGGAN.
ADMIN_USER=admin@jahityuk.test
ADMIN_PASS=ubah-di-env
KARYAWAN_USER=karyawan@jahityuk.test
KARYAWAN_PASS=ubah-di-env
PELANGGAN_USER=pelanggan@jahityuk.test
PELANGGAN_PASS=ubah-di-env

# --- Discovery -------------------------------------------------------
DISCOVERY_MAX_PAGES=30
# Pola URL yang TIDAK boleh dikunjungi crawler (dipisah koma)
DISCOVERY_SKIP=logout,keluar,delete,hapus,destroy,remove

# --- Browser ---------------------------------------------------------
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
# Remote browser (opsional). Kosongkan untuk Chromium lokal.
# Isi dengan WebSocket endpoint Playwright dari provider Anda
# (misal Browserless). Lihat dokumentasi provider untuk format URL.
BROWSER_WS_ENDPOINT=
